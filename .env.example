# Copy to .env and fill in. Every value below is a placeholder.

# Environment URL, without a trailing slash.
DATAVERSE_URL=https://yourorg.crm.dynamics.com

# Entra ID app registration used by the Dataverse application user.
DATAVERSE_TENANT_ID=00000000-0000-0000-0000-000000000000
DATAVERSE_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATAVERSE_CLIENT_SECRET=your-client-secret

# Write tools (create_record, update_record) are not exposed unless this is true.
DATAVERSE_ALLOW_WRITES=false

# Rows returned when the agent does not ask for a specific number, and the hard ceiling.
DATAVERSE_DEFAULT_TOP=25
DATAVERSE_MAX_TOP=200

DATAVERSE_TIMEOUT_SECONDS=30
